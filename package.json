{
  "name": "isabel-sera-que-fake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names WEB,API --prefix-colors magenta,cyan \"npm run dev -w @isabel/web\" \"npm run dev -w @isabel/server\"",
    "build": "npm run build -w @isabel/web -- --outDir ../dist --emptyOutDir",
    "start": "npm run start -w @isabel/server",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
